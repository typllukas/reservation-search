###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:root@mariadb:3306/reservations?serverVersion=11.4.12-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app ###
ELASTICSEARCH_DSN=http://elasticsearch:9200
# The development cluster has a single node, so it has nowhere to put a replica. At least 1 in production.
ELASTICSEARCH_REPLICAS=0
###< app ###
